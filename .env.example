# Environment Configuration Template
# Copy this to .env and fill in your actual values

# Cohere API Configuration (for embeddings)
# Get your API key from https://cohere.com/
COHERE_API_KEY=your_actual_cohere_api_key_here

# Qdrant Configuration  
# If using Docker locally:
QDRANT_URL=http://localhost:6333

# LLM Configuration - Custom OpenAI Compatible Endpoint
# Set these to use your own LLM instead of Cohere
LLM_API_BASE=http://localhost:8000
LLM_API_KEY=your_api_key_here
LLM_MODEL=your-model-name

# Optional: For Qdrant Cloud
# QDRANT_URL=https://your-instance.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
