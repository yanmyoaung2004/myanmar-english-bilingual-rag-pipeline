# ── Required ──────────────────────────────────────────
# Cohere API key (required when EMBEDDING_MODE=local)
COHERE_API_KEY=your_cohere_api_key_here

# ── Qdrant Vector DB ──────────────────────────────────
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=myanmar_english_knowledge_corp

# ── LLM (OpenAI-compatible endpoint) ──────────────────
LLM_API_BASE=http://localhost:8000
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-3.5-turbo
# Set to true if using a custom LLM at LLM_API_BASE
USE_CUSTOM_LLM=false

# ── Embedding Mode ───────────────────────────────────
# Options: local (Cohere API) | cloud (your GPU VM)
EMBEDDING_MODE=local

# Cloud embedding service (only when EMBEDDING_MODE=cloud)
CLOUD_EMBED_URL=http://localhost:8001
CLOUD_EMBED_API_KEY=
# Any model is supported:
#   sentence-transformers/LaBSE         768d  (HuggingFace, runs on cloud GPU)
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  384d
#   intfloat/multilingual-e5-small      384d
#   intfloat/multilingual-e5-base       768d
#   intfloat/multilingual-e5-large     1024d
#   BAAI/bge-m3                        1024d
#   cohere/embed-multilingual-v3.0     1024d  (Cohere API via cloud)
#   cohere/embed-english-v3.0           1024d
#   openai/text-embedding-3-small        512d  (OpenAI API via cloud)
#   openai/text-embedding-3-large       3072d
#   openai/text-embedding-ada-002       1536d
CLOUD_EMBED_MODEL=sentence-transformers/LaBSE

# ── RAG Settings ─────────────────────────────────────
CHUNK_SIZE=350
CHUNK_OVERLAP=35
RETRIEVER_TOP_K=5

# Embedding dimension:
#   Cohere multilingual-v3.0 = 1024 (local mode)
#   LaBSE                    = 768  (cloud mode)
#   multilingual-e5-base     = 768
#   multilingual-e5-large    = 1024
#   BGE-M3                   = 1024
EMBED_DIMENSION=1024

# ── Paths ────────────────────────────────────────────
DATA_DIR=data
CORPUS_RELEASES_DIR=corpus/releases

# Index PDFs in data/ automatically on startup (main.py only)
INDEX_ON_START=true
